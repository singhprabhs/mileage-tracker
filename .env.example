# Mileage Tracker - environment variables
# Copy this file to .env for local development and fill in your own values.
# Real values are never committed to the repository.
# Only these public / browser-safe keys are used in the browser; Supabase
# row-level security (added in Phase 2) protects the data.

# Supabase project URL (Phase 2)
VITE_SUPABASE_URL=
# Supabase anon (public) key (Phase 2)
VITE_SUPABASE_ANON_KEY=
# Geoapify Address Autocomplete API key, free plan (Phase 3)
VITE_GEOAPIFY_API_KEY=
